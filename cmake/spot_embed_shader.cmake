# Writes a header that embeds a compiled shader as a Spot::ShaderDesc. Run by spot_add_shaders() in script mode.
# Inputs: NAME, NAMESPACE, STAGE, SOURCE_NAME, SPIRV, VULKAN_SPIRV, MSL, REFLECTION, OUTPUT and optionally DXIL.

include("${CMAKE_CURRENT_LIST_DIR}/spot_embed_common.cmake")

function(spot_count_resources reflection key output)
    string(JSON count ERROR_VARIABLE error LENGTH "${reflection}" ${key})
    if(error)
        set(count 0)
    endif()
    set(${output} ${count} PARENT_SCOPE)
endfunction()

spot_to_identifier("${NAME}" identifier)
file(READ "${REFLECTION}" reflection)
# Texture tables, in space4, are bound whole, not slot by slot, so they are not counted.
set(sampler_count 0)
spot_count_resources("${reflection}" textures texture_count)
if(texture_count GREATER 0)
    math(EXPR last "${texture_count} - 1")
    foreach(index RANGE ${last})
        string(JSON set GET "${reflection}" textures ${index} set)
        if(NOT set EQUAL 4)
            math(EXPR sampler_count "${sampler_count} + 1")
        endif()
    endforeach()
endif()
spot_count_resources("${reflection}" ubos uniform_buffer_count)

# Storage textures and buffers, split into those the shader only reads and those it writes: for compute shaders by
# their space, space1 holding what they write; for the other stages, which only read, all of them.
set(storage_texture_count 0)
set(storage_buffer_count 0)
set(read_write_texture_count 0)
set(read_write_buffer_count 0)
foreach(kind IN ITEMS images ssbos)
    spot_count_resources("${reflection}" ${kind} count)
    if(count GREATER 0)
        math(EXPR last "${count} - 1")
        foreach(index RANGE ${last})
            string(JSON set GET "${reflection}" ${kind} ${index} set)
            if(STAGE STREQUAL "Compute" AND set EQUAL 1)
                if(kind STREQUAL "images")
                    math(EXPR read_write_texture_count "${read_write_texture_count} + 1")
                else()
                    math(EXPR read_write_buffer_count "${read_write_buffer_count} + 1")
                endif()
            elseif(kind STREQUAL "images")
                math(EXPR storage_texture_count "${storage_texture_count} + 1")
            else()
                math(EXPR storage_buffer_count "${storage_buffer_count} + 1")
            endif()
        endforeach()
    endif()
endforeach()

set(thread_counts 1 1 1)
if(STAGE STREQUAL "Compute")
    foreach(axis RANGE 2)
        string(JSON size GET "${reflection}" entryPoints 0 workgroup_size ${axis})
        list(INSERT thread_counts ${axis} ${size})
        math(EXPR next "${axis} + 1")
        list(REMOVE_AT thread_counts ${next})
    endforeach()
endif()
list(GET thread_counts 0 thread_count_x)
list(GET thread_counts 1 thread_count_y)
list(GET thread_counts 2 thread_count_z)

spot_to_byte_array("${SPIRV}" spirv_bytes)
spot_to_byte_array("${VULKAN_SPIRV}" vulkan_spirv_bytes)
spot_to_byte_array("${MSL}" msl_bytes)

set(arrays "inline constexpr std::uint8_t ${identifier}Spirv[] = {\n    ${spirv_bytes}\n};\n\n")
string(APPEND arrays "inline constexpr std::uint8_t ${identifier}VulkanSpirv[] = {\n    ${vulkan_spirv_bytes}\n};\n\n")
string(APPEND arrays "inline constexpr std::uint8_t ${identifier}Msl[] = {\n    ${msl_bytes}\n};\n")
set(dxil_span "{}")
if(DXIL)
    spot_to_byte_array("${DXIL}" dxil_bytes)
    string(APPEND arrays "\ninline constexpr std::uint8_t ${identifier}Dxil[] = {\n    ${dxil_bytes}\n};\n")
    set(dxil_span "${identifier}Dxil")
endif()

file(WRITE "${OUTPUT}.tmp" "// Generated by spot_add_shaders() from ${SOURCE_NAME}. Do not edit.
#pragma once

#include <spot.h>

#include <cstdint>

namespace ${NAMESPACE} {

${arrays}
inline constexpr Spot::ShaderDesc ${identifier}{
    .stage = Spot::ShaderStage::${STAGE},
    .spirv = ${identifier}Spirv,
    .vulkanSpirv = ${identifier}VulkanSpirv,
    .msl = ${identifier}Msl,
    .dxil = ${dxil_span},
    .samplerCount = ${sampler_count},
    .storageTextureCount = ${storage_texture_count},
    .storageBufferCount = ${storage_buffer_count},
    .uniformBufferCount = ${uniform_buffer_count},
    .readWriteStorageTextureCount = ${read_write_texture_count},
    .readWriteStorageBufferCount = ${read_write_buffer_count},
    .threadCountX = ${thread_count_x},
    .threadCountY = ${thread_count_y},
    .threadCountZ = ${thread_count_z},
};

} // namespace ${NAMESPACE}
")
file(COPY_FILE "${OUTPUT}.tmp" "${OUTPUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUTPUT}.tmp")
