# Runtime libraries that the compiler normally expects to find on the developer's machine.
function(spot_get_runtime_libraries output)
    set(libraries)
    if(MSVC)
        set(CMAKE_INSTALL_SYSTEM_RUNTIME_LIBS_SKIP TRUE)
        include(InstallRequiredSystemLibraries)
        set(libraries ${CMAKE_INSTALL_SYSTEM_RUNTIME_LIBS})
    elseif(MINGW)
        set(names libstdc++-6.dll libgcc_s_seh-1.dll libgcc_s_dw2-1.dll libgcc_s_sjlj-1.dll libwinpthread-1.dll)
    elseif(UNIX AND NOT APPLE)
        set(names libstdc++.so.6 libgcc_s.so.1)
    endif()
    foreach(name IN LISTS names)
        execute_process(COMMAND "${CMAKE_CXX_COMPILER}" "-print-file-name=${name}"
            OUTPUT_VARIABLE library OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE result)
        if(result EQUAL 0 AND IS_ABSOLUTE "${library}" AND EXISTS "${library}")
            cmake_path(NORMAL_PATH library)
            list(APPEND libraries "${library}")
        endif()
    endforeach()
    list(REMOVE_DUPLICATES libraries)
    set(${output} "${libraries}" PARENT_SCOPE)
endfunction()
