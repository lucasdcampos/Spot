# The Spot engine as games link it: the shared library of one build of the engine, written by that build. Projects
# find it with find_package(Spot CONFIG), which the tools point here when they build them. An installed engine has
# its own package (SpotInstalledConfig.cmake.in).

set(SPOT_LIBRARY "$<TARGET_FILE:spot_shared>")
set(SPOT_IMPORT_LIBRARY "$<TARGET_LINKER_FILE:spot_shared>")
set(SPOT_INCLUDE_DIR "@SPOT_INCLUDE_DIR@")
set(SPOT_WITH_SCRIPTING @SPOT_SCRIPTING@)
set(SPOT_WITH_LUAU @SPOT_ENABLE_LUAU@)
set(SPOT_SHADER_GLSLANG "$<TARGET_FILE:glslang-standalone>")
set(SPOT_SHADER_SPIRV_CROSS "$<TARGET_FILE:spirv-cross>")
set(SPOT_DXC "@SPOT_DXC@")
set(SPOT_SHADER_INCLUDE_DIR "@SPOT_SHADER_INCLUDE_DIR@")
include("@PROJECT_SOURCE_DIR@/cmake/spot_game.cmake")
