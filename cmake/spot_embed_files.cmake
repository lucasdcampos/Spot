# spot_embed_files(<target> [NAMESPACE <namespace>] <file>...)
# Generates "<file>.h" for each file (e.g. "inter_regular.ttf.h"), which defines the file's bytes as a
# std::span<const std::uint8_t> named after the file in PascalCase (e.g. Resources::InterRegularTtf), so the target
# needs no files next to it at runtime.

if(CMAKE_SCRIPT_MODE_FILE)
    # Script mode, run at build time by the command below. Inputs: NAME, NAMESPACE, SOURCE, OUTPUT.
    include("${CMAKE_CURRENT_LIST_DIR}/spot_embed_common.cmake")

    spot_to_identifier("${NAME}" identifier)
    spot_to_byte_array("${SOURCE}" bytes)
    file(WRITE "${OUTPUT}.tmp" "// Generated by spot_embed_files() from ${NAME}. Do not edit.
#pragma once

#include <cstdint>
#include <span>

namespace ${NAMESPACE} {

inline constexpr std::uint8_t ${identifier}Data[] = {
    ${bytes}
};

inline constexpr std::span<const std::uint8_t> ${identifier} = ${identifier}Data;

} // namespace ${NAMESPACE}
")
    file(COPY_FILE "${OUTPUT}.tmp" "${OUTPUT}" ONLY_IF_DIFFERENT)
    file(REMOVE "${OUTPUT}.tmp")
    return()
endif()

set(SPOT_EMBED_FILES_SCRIPT "${CMAKE_CURRENT_LIST_FILE}")
set(SPOT_EMBED_COMMON_SCRIPT "${CMAKE_CURRENT_LIST_DIR}/spot_embed_common.cmake")

function(spot_embed_files target)
    cmake_parse_arguments(PARSE_ARGV 1 ARG "" "NAMESPACE" "")
    if(NOT ARG_NAMESPACE)
        set(ARG_NAMESPACE Resources)
    endif()

    set(output_dir "${CMAKE_CURRENT_BINARY_DIR}/spot_embedded/${target}")
    set(headers)
    foreach(source IN LISTS ARG_UNPARSED_ARGUMENTS)
        get_filename_component(source "${source}" ABSOLUTE)
        get_filename_component(file_name "${source}" NAME)
        set(header "${output_dir}/${file_name}.h")
        add_custom_command(
            OUTPUT "${header}"
            COMMAND ${CMAKE_COMMAND} -E make_directory "${output_dir}"
            COMMAND ${CMAKE_COMMAND} "-DNAME=${file_name}" "-DNAMESPACE=${ARG_NAMESPACE}" "-DSOURCE=${source}"
                    "-DOUTPUT=${header}" -P "${SPOT_EMBED_FILES_SCRIPT}"
            DEPENDS "${source}" "${SPOT_EMBED_FILES_SCRIPT}" "${SPOT_EMBED_COMMON_SCRIPT}"
            COMMENT "Embedding ${file_name}"
            VERBATIM
        )
        list(APPEND headers "${header}")
    endforeach()

    target_sources(${target} PRIVATE ${headers})
    target_include_directories(${target} PRIVATE "${output_dir}")
endfunction()
