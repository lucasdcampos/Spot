import core

class Counter {
    var value = 0

    func init(value) {
        self.value = value
    }

    func add(amount) {
        value += amount
        return value
    }
}

class DoubleCounter : Counter {
    func init(value) {
        super.init(value)
    }

    override func add(amount) {
        return super.add(amount * 2)
    }
}

func start() {
    var first = DoubleCounter(10)
    var second = DoubleCounter(1)
    const alias = first
    print(first.add(3)) // 16
    print(second.add(2)) // 5
    core.assert(alias == first and first != second)
    core.assert(alias.value == 16 and second.value == 5)
}
