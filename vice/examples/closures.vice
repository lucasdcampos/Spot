// closures.vice: anonymous functions, captured variables and local functions.

import core

func MakeCounter(start) {
    var count = start
    return func(step) {
        count += step
        return count
    }
}

class Timer {
    var elapsed = 0
    var listeners = []

    func OnTick(listener) {
        listeners.push(listener)
    }

    func Advance(delta_time) {
        elapsed += delta_time
        for listener in listeners {
            listener(elapsed)
        }
    }
}

const timer = Timer()
const counter = MakeCounter(0)

func start() {
    func Fibonacci(n) {
        if n < 2 { return n }
        return Fibonacci(n - 1) + Fibonacci(n - 2)
    }
    print("fibonacci(10):", Fibonacci(10))

    var ticks = 0
    timer.OnTick(func(elapsed) { ticks += 1 })
    timer.OnTick(func(elapsed) { counter(10) })
    const waves = []
    for wave in range(1, 4) {
        waves.push(func() { return "wave " + core.to_string(wave) })
    }
    for spawn in waves {
        print(spawn())
    }
    timer.Advance(0.5)
    print("ticks:", ticks, "counter:", counter(0))
}

func update(delta_time) {
    timer.Advance(delta_time)
    print("counter:", counter(0))
}
