import spot

// Drive the game's C++ DayCycle through its registered API.
class DayControls : Component {
    var sun
    var runningDayLength = 480

    override func OnStart() {
        sun = scene.FindEntity("Sun")
        if sun != null and sun.GetComponent("DayCycle") != null {
            runningDayLength = sun.GetComponent("DayCycle").dayLength
        }
        print("VICE demos: J morning, K noon, L night, P pause day, M fade music, N toggle monument neon.")
    }

    override func OnUpdate(deltaTime) {
        if deltaTime <= 0 or sun == null or not sun.IsValid() { return }
        var cycle = sun.GetComponent("DayCycle")
        if cycle == null { return }

        if spot.Input.IsKeyPressed("J") { cycle.SetTimeOfDay(0.30) }
        if spot.Input.IsKeyPressed("K") { cycle.SetTimeOfDay(0.50) }
        if spot.Input.IsKeyPressed("L") { cycle.SetTimeOfDay(0.90) }

        // A zero day length stops time while keeping the cycle available to the night lamps.
        if spot.Input.IsKeyPressed("P") {
            if cycle.dayLength > 0 {
                runningDayLength = cycle.dayLength
                cycle.dayLength = 0
            } else {
                cycle.dayLength = runningDayLength
            }
        }
    }
}
