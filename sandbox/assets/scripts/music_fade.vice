import spot
import math

// Fade the existing music source; keep playback running so M preserves the song's position.
class MusicFade : Component {
    var audio
    var fullVolume = 0
    var muted = false

    override func OnStart() {
        audio = entity.GetComponent("AudioSource")
        fullVolume = audio.volume
        audio.volume = 0
    }

    override func OnUpdate(deltaTime) {
        if deltaTime <= 0 { return }
        if spot.Input.IsKeyPressed("M") { muted = not muted }

        var target = fullVolume
        if muted { target = 0 }
        var volume = audio.volume
        var step = fullVolume * deltaTime / 1.5
        if volume < target {
            volume = math.min(volume + step, target)
        } else if volume > target {
            volume = math.max(volume - step, target)
        }
        audio.volume = volume
    }
}
