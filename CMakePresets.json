{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 25,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "binaryDir": "${sourceDir}/build/${presetName}"
        },
        {
            "name": "msvc",
            "displayName": "Visual Studio 2026",
            "description": "Windows build with MSVC (multi-config)",
            "inherits": "base",
            "generator": "Visual Studio 18 2026",
            "architecture": "x64",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "ninja",
            "displayName": "Ninja Multi-Config",
            "description": "Build with Ninja and the default compiler (Linux, macOS or Windows)",
            "inherits": "base",
            "generator": "Ninja Multi-Config",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        }
    ],
    "buildPresets": [
        { "name": "msvc-debug", "configurePreset": "msvc", "configuration": "Debug" },
        { "name": "msvc-release", "configurePreset": "msvc", "configuration": "Release" },
        { "name": "ninja-debug", "configurePreset": "ninja", "configuration": "Debug" },
        { "name": "ninja-release", "configurePreset": "ninja", "configuration": "Release" }
    ],
    "testPresets": [
        {
            "name": "base",
            "hidden": true,
            "output": { "outputOnFailure": true },
            "execution": { "jobs": 2 }
        },
        {
            "name": "headless",
            "hidden": true,
            "inherits": "base",
            "filter": { "exclude": { "label": "gpu" } }
        },
        {
            "name": "gpu",
            "hidden": true,
            "inherits": "base",
            "filter": { "include": { "label": "gpu" } },
            "execution": { "jobs": 1 }
        },
        {
            "name": "gpu-sdl-gpu",
            "hidden": true,
            "inherits": "gpu",
            "environment": { "SPOT_GRAPHICS_BACKEND": "sdl_gpu" }
        },
        {
            "name": "gpu-vulkan",
            "hidden": true,
            "inherits": "gpu",
            "environment": { "SPOT_GRAPHICS_BACKEND": "vulkan" }
        },
        { "name": "msvc-debug", "inherits": "headless", "configurePreset": "msvc", "configuration": "Debug" },
        { "name": "msvc-release", "inherits": "headless", "configurePreset": "msvc", "configuration": "Release" },
        { "name": "ninja-debug", "inherits": "headless", "configurePreset": "ninja", "configuration": "Debug" },
        { "name": "ninja-release", "inherits": "headless", "configurePreset": "ninja", "configuration": "Release" },
        { "name": "msvc-debug-gpu", "inherits": "gpu", "configurePreset": "msvc", "configuration": "Debug" },
        { "name": "msvc-release-gpu", "inherits": "gpu", "configurePreset": "msvc", "configuration": "Release" },
        { "name": "ninja-debug-gpu", "inherits": "gpu", "configurePreset": "ninja", "configuration": "Debug" },
        { "name": "ninja-release-gpu", "inherits": "gpu", "configurePreset": "ninja", "configuration": "Release" },
        { "name": "msvc-debug-gpu-sdl-gpu", "inherits": "gpu-sdl-gpu", "configurePreset": "msvc", "configuration": "Debug" },
        { "name": "msvc-debug-gpu-vulkan", "inherits": "gpu-vulkan", "configurePreset": "msvc", "configuration": "Debug" },
        { "name": "msvc-release-gpu-sdl-gpu", "inherits": "gpu-sdl-gpu", "configurePreset": "msvc", "configuration": "Release" },
        { "name": "msvc-release-gpu-vulkan", "inherits": "gpu-vulkan", "configurePreset": "msvc", "configuration": "Release" },
        { "name": "ninja-debug-gpu-sdl-gpu", "inherits": "gpu-sdl-gpu", "configurePreset": "ninja", "configuration": "Debug" },
        { "name": "ninja-debug-gpu-vulkan", "inherits": "gpu-vulkan", "configurePreset": "ninja", "configuration": "Debug" },
        { "name": "ninja-release-gpu-sdl-gpu", "inherits": "gpu-sdl-gpu", "configurePreset": "ninja", "configuration": "Release" },
        { "name": "ninja-release-gpu-vulkan", "inherits": "gpu-vulkan", "configurePreset": "ninja", "configuration": "Release" },
        { "name": "msvc-debug-all", "inherits": "base", "configurePreset": "msvc", "configuration": "Debug" },
        { "name": "msvc-release-all", "inherits": "base", "configurePreset": "msvc", "configuration": "Release" },
        { "name": "ninja-debug-all", "inherits": "base", "configurePreset": "ninja", "configuration": "Debug" },
        { "name": "ninja-release-all", "inherits": "base", "configurePreset": "ninja", "configuration": "Release" }
    ]
}
