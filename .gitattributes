# Normalize line endings so the repo behaves the same on Windows, macOS and Linux.
* text=auto

# Shell scripts break with CRLF, even when checked out on Windows.
*.sh text eol=lf

# Binary model data must never have its bytes converted.
*.bin binary
*.glb binary
*.ttf binary
*.otf binary

# The sandbox generator compares its output with these byte for byte, so checkouts must not change their line ends.
sandbox/assets/generated/**/*.gltf -text
